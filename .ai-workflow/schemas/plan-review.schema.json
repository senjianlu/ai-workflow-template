{
  "type": "object",
  "additionalProperties": false,
  "required": ["issues", "advisories", "scope_findings", "overall"],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "summary", "consequence", "detail"],
        "properties": {
          "id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["plan-blocker", "major", "minor"]
          },
          "category": {
            "type": "string",
            "enum": [
              "premise",
              "requirement",
              "contract",
              "convention",
              "feasibility",
              "acceptance",
              "other"
            ]
          },
          "summary": { "type": "string" },
          "consequence": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "advisories": { "type": "array", "items": { "type": "string" } },
    "scope_findings": { "type": "array", "items": { "type": "string" } },
    "overall": { "type": "string" }
  }
}
