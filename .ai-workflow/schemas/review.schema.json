{
  "type": "object",
  "additionalProperties": false,
  "required": ["issues", "test_gaps", "advisories", "scope_findings", "overall"],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "file", "line", "summary", "scenario", "detail"],
        "properties": {
          "id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["plan-blocker", "blocker", "major", "minor"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "summary": { "type": "string" },
          "scenario": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "test_gaps": { "type": "array", "items": { "type": "string" } },
    "advisories": { "type": "array", "items": { "type": "string" } },
    "scope_findings": { "type": "array", "items": { "type": "string" } },
    "overall": { "type": "string" }
  }
}
