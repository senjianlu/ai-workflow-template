#!/usr/bin/env bash
# codex 桩:行为由 STUB_MODE 控制;解析 --output-last-message 与 --json。
# 事件行写 stdout(脚本把它重定向到 events 文件),结论 JSON 写 -o 指定文件。
out=; json=0
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  case "${args[i]}" in
    --output-last-message|-o) out="${args[i+1]}" ;;
    --json) json=1 ;;
  esac
done
ev() { [ "$json" = 1 ] && echo "{\"type\":\"$1\"}"; return 0; }
write_pass() { printf '{"verdict":"pass","issues":[],"overall":"stub ok"}\n' > "$out"; }
case "${STUB_MODE:-pass}" in
  pass)   ev thread.started; ev turn.started; ev turn.completed; write_pass; exit 0 ;;
  stdin)  cat >/dev/null; ev thread.started; ev turn.started; ev turn.completed; write_pass; exit 0 ;;
  idle)   ev thread.started; sleep 300 ;;
  chatty) while :; do ev item.completed; sleep 1; done ;;
  tree)
    d="$STUB_DIR"
    bash -c 'sleep 300 & echo $! > "$0"' "$d/grandchild.pid"      # 中间进程立即退出,孙进程改挂 init
    bash -c 'trap "" TERM; exec sleep 301' & echo $! > "$d/ignorer.pid"   # exec 后 sleep 继承忽略 TERM
    ps -o sid= -p $$ | tr -d ' ' > "$d/stub.sid"
    ev thread.started; sleep 300 ;;
  slow)   for i in 1 2 3 4 5 6; do ev item.completed; sleep 1; done; write_pass; exit 0 ;;
  late)   for i in 1 2 3 4 5 6 7; do ev item.completed; sleep 1; done; sleep 0.5; write_pass; exit 0 ;;
  early)  sleep 300 & echo $! > "$STUB_DIR/child.pid"; ev thread.started; exit 0 ;;   # 主进程先退出,后代继续持锁 fd
  *) echo "unknown STUB_MODE" >&2; exit 2 ;;
esac
